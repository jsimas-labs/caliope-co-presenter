# Calíope co-presenter: local settings (copy to .env; .env is not committed)
OPENAI_API_KEY=

# Talk language (BCP 47) and presenter
LANGUAGE=pt-BR
PRESENTER_NAME=Jonathan
ASSISTANT_NAME=Calíope
# ASSISTANT_NICK=Cali
# WAKE_WORDS=calíope, caliope, calliope, cali

# Voice: gpt-realtime-2.1 for the talk; gpt-realtime-2.1-mini in rehearsals (about 1/3 of the cost)
REALTIME_MODEL=gpt-realtime-2.1
REALTIME_VOICE=marin
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# macOS voice for LANGUAGE (Luciana for pt-BR, Samantha for en-US), or realtime for the OpenAI voice
# CALIOPE_VOICE=Luciana

# Stage: Playwright's Chromium. To use the installed Google Chrome, uncomment:
# BROWSER_CHANNEL=chrome
DECK_URL=http://localhost:8787/deck/
DEMO_URL=http://localhost:8787/demo/
TYPE_WPM=40
CURSOR_STEPS=16

# pause (ms) that closes your sentence; lower = faster, but may cut you mid-sentence
SILENCE_MS=300
PORT=8787
